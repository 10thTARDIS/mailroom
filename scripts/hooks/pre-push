#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
#
# PRE-PUSH PORTABILITY GATE.
#
# On a public forge a push is published the moment it lands: CI runs AFTER
# that, so CI can report a leak but never prevent one. This hook is the gate
# in front of the forge. For every commit being pushed it checks, against the
# operator denylist (scripts/portability-check.sh, layer 1):
#
#   - the TREE of each pushed branch tip (git grep on the commit, not the
#     working tree, so uncommitted edits neither hide nor cause a hit);
#   - every line ADDED by any pushed commit (a leak removed again before the
#     tip is still published in the intermediate commit);
#   - every pushed commit's MESSAGE, and its author and committer NAME and
#     EMAIL (a personal address in a commit identity is as public as one in a
#     file).
#
# The denylist lives OUTSIDE the repository, in
#   $MAILROOM_PORTABILITY_PATTERNS_FILE (default ~/.config/mailroom/portability-patterns)
# one extended regex per line, '#' comments allowed — the same format as the
# CI secret. Writing those strings into the repo would be the leak itself.
#
# It FAILS CLOSED: no denylist file means the push is refused, because a gate
# that silently checks nothing is the failure it exists for. `git push
# --no-verify` bypasses every hook; never use it for this repository.
#
# Enable once per clone:   git config core.hooksPath scripts/hooks
set -eu

remote_name="${1:-origin}"
top="$(git rev-parse --show-toplevel)"
check="$top/scripts/portability-check.sh"
patterns="${MAILROOM_PORTABILITY_PATTERNS_FILE:-$HOME/.config/mailroom/portability-patterns}"

if [ ! -r "$patterns" ]; then
  echo "pre-push: REFUSED — no operator denylist at $patterns." >&2
  echo "  Create it (one extended regex per line: your domains, hostnames, org and" >&2
  echo "  user names, internal addresses, personal email domains), or point" >&2
  echo "  MAILROOM_PORTABILITY_PATTERNS_FILE at it. Nothing was pushed." >&2
  exit 1
fi

zero="0000000000000000000000000000000000000000"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  # A deletion pushes no content.
  [ "$local_sha" = "$zero" ] && continue

  # Which commits does this push publish? Against a branch the remote already
  # has: the new ones. Against a new branch: everything not already on the
  # remote under any name.
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes=$remote_name"
  else
    range="$remote_sha..$local_sha"
  fi

  # shellcheck disable=SC2086 # $range is deliberately split into rev-list args
  if ! git log --format='%an%n%ae%n%cn%n%ce%n%B' $range \
       | sh "$check" --patterns-file "$patterns" --messages >/dev/null; then
    echo "pre-push: REFUSED — $local_ref: a commit message or author/committer identity" >&2
    echo "  matches the operator denylist. Reword (git commit --amend / rebase) or fix" >&2
    echo "  the identity (git config user.email), then push again." >&2
    status=1
  fi

  # Lines ADDED by any pushed commit. The tip's tree (below) is not enough: a
  # leak added in one commit and removed in a later one leaves a clean tip,
  # but the intermediate commit is published with the history all the same.
  # shellcheck disable=SC2086
  if ! git log --format= -p --no-ext-diff --no-color $range \
       | grep -a '^+' | sh "$check" --patterns-file "$patterns" --messages >/dev/null; then
    echo "pre-push: REFUSED — $local_ref: a pushed commit ADDS operator-specific text" >&2
    echo "  (it may be gone at the tip, but the commit would still be published)." >&2
    echo "  Rewrite the commits that add it (git rebase -i), then push again." >&2
    status=1
  fi

  if ! out="$(sh "$check" --patterns-file "$patterns" --rev "$local_sha" --denylist-only 2>&1)"; then
    echo "pre-push: REFUSED — $local_ref: the tree at ${local_sha%"${local_sha#???????}"} contains" >&2
    echo "  operator-specific text (matched text withheld):" >&2
    printf '%s\n' "$out" | sed -n 's/^        /    /p' >&2
    status=1
  fi
done

exit "$status"
