          "padding": "4px 8px"
        },
        "within": "table"
      }
    ]
  },
  {
    "name": "table, header row",
    "html": "<p>before</p><table style=\"border-collapse: collapse;\"><tbody><tr><th scope=\"col\" style=\"padding: 4px 8px; text-align: left; font-weight: bold; border: 1px solid rgb(153, 153, 153);\"><p>Item</p></th><th scope=\"col\" style=\"padding: 4px 8px; text-align: left; font-weight: bold; border: 1px solid rgb(153, 153, 153);\"><p>Qty</p></th><th scope=\"col\" style=\"padding: 4px 8px; text-align: left; font-weight: bold; border: 1px solid rgb(153, 153, 153);\"><p>Price</p></th></tr><tr><td style=\"padding: 4px 8px; border: 1px solid rgb(153, 153, 153);\"><p>Apple</p></td><td style=\"padding: 4px 8px; border: 1px solid rgb(153, 153, 153);\"><p>3</p></td><td style=\"padding: 4px 8px; border: 1px solid rgb(153, 153, 153);\"><p>1.50</p></td></tr><tr><td style=\"padding: 4px 8px; border: 1px solid rgb(153, 153, 153);\"><p>Watermelon</p></td><td style=\"padding: 4px 8px; border: 1px solid rgb(153, 153, 153);\"><p>12</p></td><td style=\"padding: 4px 8px; border: 1px solid rgb(153, 153, 153);\"><p>0.20</p></td></tr></tbody></table><p><br></p>",
    "text": "before\nItem        Qty  Price\n----------  ---  -----\nApple       3    1.50\nWatermelon  12   0.20",
    "expect": [
      {
        "tag": "table",
        "style": {
          "border-collapse": "collapse"
        }
      },
