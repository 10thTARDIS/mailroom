          "text-align": "left",
          "font-weight": "bold"
        },
        "attrs": {
          "scope": "col"
        },
        "within": "table"
      },
      {
        "tag": "td",
        "style": {
          "border": "1px solid rgb(153, 153, 153)",
          "padding": "4px 8px"
        },
        "within": "table"
      }
    ]
  },
